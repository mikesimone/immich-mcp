# /etc/immich-mcp/immich-mcp.env  (non-secret settings; secrets are files referenced below)

# --- Immich -------------------------------------------------------------------------------
IMMICH_URL=http://127.0.0.1:2283
# A dedicated, scoped Immich API key (see README for the permission list), in a file readable only by the service user.
IMMICH_API_KEY_FILE=/etc/immich-mcp/immich-api-key

# --- What connected AI clients may see (REQUIRED) -------------------------------------------
# Comma-separated album-name prefixes. Only albums whose names start with one of these, and the assets in
# them, are visible. Use * for every album (assets in no album are never visible).
ALLOWED_ALBUM_PREFIXES=Family - ,Pets - ,Memes -

# --- Auth at the MCP boundary -------------------------------------------------------------
# token: per-client tokens for loopback clients (Claude Code, a tunnel client); cloudflare: a public endpoint
# behind Cloudflare Access (Managed OAuth) for ChatGPT / Claude.ai connectors. Combine with a comma.
AUTH_MODE=token
TOKEN_FILE=/etc/immich-mcp/client-tokens          # lines of "client-name:token" (32+ chars), re-read per request
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<the Access application's AUD tag>
# ALLOWED_EMAILS=you@example.com

# --- Listener -------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8099
ALLOWED_HOSTS=127.0.0.1:8099,localhost:8099       # add your public hostname if you expose it

# --- Optional -------------------------------------------------------------------------------
# ENABLE_SHARE_LINKS=true                            # create_share_link tool (needs confirm=true per call)
# PUBLIC_IMMICH_URL=https://photos.example.com       # what share-link recipients open
# INSTRUCTIONS_EXTRA=New memes go to the album "Memes - Inbox".   # appended to the server instructions; \n = newline
# MAX_UPLOAD_BYTES=209715200
# MAX_BASE64_BYTES=7340032
# URL_FETCH_ALLOWED_HOSTS=                           # restrict url ingestion to these hosts (default: any public host)
